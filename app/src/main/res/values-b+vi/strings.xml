    <string name="safety_title">Bảo mật ví · %1$d/2</string>
    <string name="safety_question_1">Ai đó tự xưng là nhóm Q-BitX yêu cầu cụm từ hạt giống của bạn. Bạn nên làm gì?</string>
    <string name="safety_question_2">Nếu tôi mất cụm từ gốc và mọi bản sao lưu wallet.dat, ai có thể khôi phục quyền truy cập của tôi?</string>
    <string name="safety_wrong_1">Có, tôi phải cung cấp cụm từ gốc của mình</string>
    <string name="safety_right_1">Không, họ là những kẻ lừa đảo</string>
    <string name="safety_wrong_2">Nhóm Q-BitX có thể khôi phục ví và tiền của tôi</string>
    <string name="safety_right_2">Nhóm không thể khôi phục quyền truy cập của tôi</string>
    <string name="safety_explanation_1">Nhóm Q-BitX sẽ không bao giờ yêu cầu cụm từ gốc hoặc tệp wallet.dat của bạn. Bất cứ ai yêu cầu chúng đều là kẻ lừa đảo.</string>
    <string name="safety_explanation_2">Nhóm Q-BitX không có quyền truy cập vào ví hoặc bản sao lưu khôi phục của bạn. Nếu mọi bản sao của hạt giống, khóa và tệp khôi phục của bạn bị mất, quyền truy cập vào tiền của bạn sẽ bị mất vĩnh viễn.</string>
    <string name="protect_wallet_title">Bảo vệ ví của bạn</string>
    <string name="protect_wallet_message">Đặt khóa màn hình trong cài đặt Android, sau đó mở lại Q-BitX.</string>
    <string name="close_button">Đóng</string>
    <string name="import_file_hint">Core SQLite wallet.dat: tất cả khóa PQ được nhập dưới dạng tài khoản riêng biệt. Số dư được hiển thị cho tài khoản đã chọn. Các tệp DB được mã hóa và Berkeley không được hỗ trợ.</string>
    <string name="seed_import_hint">24 từ gốc tiếng Anh hoặc sao lưu khóa kế thừa</string>
    <string name="seed_backup_hint">Một hạt giống khôi phục tài khoản của nó. Giữ các từ ngoại tuyến. Thêm lại tài khoản theo thứ tự sau khi khôi phục hạt giống; wallet.dat lưu mọi tài khoản được lưu trữ.</string>
    <string name="dat_export">Xuất wallet.dat</string>
    <string name="dat_export_hint">Bản sao lưu Core SQLite không được mã hóa của tất cả các ví và tài khoản được lưu trữ trong ứng dụng này.</string>
    <string name="dat_warning_title">wallet.dat không được mã hóa</string>
    <string name="dat_warning_text">Bất kỳ ai có tệp này đều có thể sử dụng QBX của bạn. Lưu nó ngoại tuyến; không bao giờ chia sẻ nó với bộ phận hỗ trợ hoặc tải nó lên một trang web. Tệp này chứa tất cả các khóa ví được lưu trữ trong ứng dụng này.</string>
